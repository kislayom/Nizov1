# Nizo environment template — copy to ~/.nizo/.env (mode 600) on the server.
# All keys here are READ at startup; missing keys disable the corresponding feature.

# ---- LLM endpoint (REQUIRED) ----------------------------------------------
# Defaults to http://localhost:8080 (llama-server on the same box). When the
# Java agent runs on the laptop, point at the server or open an SSH tunnel.
NIZO_LLM_URL=http://localhost:8080
NIZO_LLM_MODEL=Qwen/Qwen3.6-27B
# Optional bearer token if your llama-server is behind auth.
NIZO_LLM_TOKEN=
# Per-LLM-call wall clock; raise if Q8 + 256K context routinely runs > 4 min.
NIZO_LLM_TIMEOUT_MIN=10

# ---- Web channel (REQUIRED for UI) ----------------------------------------
# Bind to 127.0.0.1 by default. Only override if you've added auth in front
# (a reverse proxy, WireGuard tunnel, etc.) — :7777 has limited per-endpoint
# token gating but is not designed for public exposure.
NIZO_WEB_HOST=127.0.0.1
NIZO_WEB_PORT=7777

# ---- Agent loop tuning -----------------------------------------------------
# Max iterations before the orchestrator gives up. 30 catches most stock-research
# pipelines without runaway loops.
NIZO_AGENT_MAX_ITERATIONS=30
# How many recent messages to load as prompt history.
NIZO_HISTORY_MESSAGES=24
# Per-call LLM timeout inside SubAgentSkillTool (ms). Sub-agents are bounded
# below the orchestrator's own timeout to keep a hung analyst from wedging
# the parent. 180000 = 3 min.
NIZO_SUBAGENT_LLM_TIMEOUT_MS=180000
# Max chars from a tool result we paste back into the sub-agent's context.
# Web fetches return ~50KB; without truncation the context grows unbounded.
NIZO_SUBAGENT_TOOL_RESULT_MAX_CHARS=4000

# ---- Voice sidecar (OPTIONAL — required for iOS app) ----------------------
NIZO_VOICE_URL=http://localhost:7780

# ---- Telegram channel (OPTIONAL) ------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ---- Web search (OPTIONAL — falls back to Bing/DDG if unset) -------------
# SearXNG: self-hosted; preferred when available (no quota, fast).
SEARXNG_BASE_URL=
# Brave Search API: 2000 free queries/month, lower than SearXNG but no host needed.
BRAVE_API_KEY=

# ---- Finnhub (OPTIONAL — Tier-3 fallback below Yahoo + FMP) --------------
# Finnhub gives ticker autocomplete + analyst recommendations + earnings +
# insider transactions when Yahoo / FMP exhaust or throttle. Free tier is
# 60 req/min with no daily cap. Sign up: https://finnhub.io/register
# Single token (no rotation needed at this scale).
FINNHUB_TOKEN=

# ---- FMP (OPTIONAL — Tier-2 fallback below Yahoo) ------------------------
# Financial Modeling Prep — primary source for analyst ratings, earnings
# history, insider transactions when Yahoo throttles. Free tier 250/day per
# key; up to 5 keys auto-rotated. Signup: https://site.financialmodelingprep.com/
# FMP_API_KEY=
# FMP_API_KEY1=
# FMP_API_KEY2=

# ---- SmartProxy (OPTIONAL — bot-bypass for protected sites) --------------
# When all four are set, WebFetchTool retries failed direct fetches via SmartProxy.
# Without this you'll see 403/captcha errors on stocktitan, wsj, marketwatch, etc.
SMARTPROXY_USERNAME=
SMARTPROXY_PASSWORD=
SMARTPROXY_GEO=us
SMARTPROXY_LOCALE=en-US
# Set to 1 to enable JS rendering on the proxy (slower, costs more credits).
SMARTPROXY_JS_RENDER=0

# ---- Network safety (OPTIONAL) -------------------------------------------
# By default the SSRF guard blocks loopback/RFC1918/link-local. Set to 1 if
# you genuinely need the agent to fetch http://localhost (rare; only useful
# for dev tooling that exposes APIs locally).
NIZO_NET_ALLOW_LOOPBACK=0

# ---- Shell tool (OPTIONAL) ------------------------------------------------
# By default ShellTool runs with a scrubbed env (PATH, HOME, LANG, USER, SHELL,
# TERM only) so a prompt-injected `env|curl` can't exfiltrate API keys.
# Comma-separated list of additional env vars to pass through if needed.
NIZO_SHELL_ENV_EXTRA=
