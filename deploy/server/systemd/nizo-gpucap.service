[Unit]
# DORMANT CONTINGENCY — this unit is intentionally DISABLED. The box runs full 300W; thermals are
# handled by nizo-gpu-thermal (fan). There is NO proven load-fault: a "network drop under load" once
# suspected turned out to be an intentional operator shutdown (2026-06-17), so no power cap is
# justified. Keep this file only so a 250W cap can be re-enabled quickly IF a genuine, unexplained,
# confirmed-not-user-initiated load-drop is ever actually observed. Do not enable it speculatively.
Description=Nizo GPU power cap — 250W (DISABLED contingency; enable only on a confirmed load-fault)
# Ordering note (kept correct for if it's ever enabled): do NOT add After=multi-user.target — that
# plus WantedBy=multi-user.target plus Before=nizo-llama (itself in multi-user.target) is an ordering
# cycle systemd breaks by deleting this job, leaving the box uncapped at boot.
After=local-fs.target
Before=nizo-llama.service

[Service]
Type=oneshot
ExecStart=/usr/bin/nvidia-smi -pl 250
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
