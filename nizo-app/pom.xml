<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.nizo</groupId>
        <artifactId>nizo-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>nizo-app</artifactId>
    <name>Nizo — App (entry point + uber-jar)</name>
    <description>Bootstrap and uber-jar packaging. Wires nizo-llm, nizo-memory, nizo-channels, etc.</description>

    <dependencies>
        <dependency>
            <groupId>ai.nizo</groupId>
            <artifactId>nizo-api</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.nizo</groupId>
            <artifactId>nizo-llm</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.nizo</groupId>
            <artifactId>nizo-agent</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.nizo</groupId>
            <artifactId>nizo-channels</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.nizo</groupId>
            <artifactId>nizo-skills</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.nizo</groupId>
            <artifactId>nizo-tools</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.nizo</groupId>
            <artifactId>nizo-mcp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>nizo</finalName>
        <plugins>
            <plugin>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>ai.nizo.app.Main</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
