<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ai.nizo</groupId>
    <artifactId>nizo-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Nizo — Personal Agent Platform</name>
    <description>Self-learning local-first agent. Java 21, no Spring. Runs on a local Qwen3.6-27B via vLLM/Ollama.</description>

    <modules>
        <module>nizo-memory</module>

        <module>nizo-api</module>
        <module>nizo-llm</module>
        <module>nizo-skills</module>
        <module>nizo-tools</module>
        <module>nizo-mcp</module>
        <module>nizo-scheduler</module>
        <module>nizo-channels</module>
        <module>nizo-agent</module>
        <module>nizo-app</module>
    </modules>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <jackson.version>2.17.2</jackson.version>
        <slf4j.version>2.0.13</slf4j.version>
        <junit.version>5.10.2</junit.version>
        <sqlite.version>3.46.0.0</sqlite.version>
        <telegrambots.version>9.0.0</telegrambots.version>
        <cronutils.version>9.2.1</cronutils.version>
        <picocli.version>4.7.6</picocli.version>
        <jsoup.version>1.18.1</jsoup.version>

        <nizo.version>${project.version}</nizo.version>
        <nizo.memory.version>0.1.0-SNAPSHOT</nizo.memory.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ai.nizo</groupId>
                <artifactId>nizo-api</artifactId>
                <version>${nizo.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.nizo</groupId>
                <artifactId>nizo-llm</artifactId>
                <version>${nizo.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.nizo</groupId>
                <artifactId>nizo-skills</artifactId>
                <version>${nizo.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.nizo</groupId>
                <artifactId>nizo-tools</artifactId>
                <version>${nizo.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.nizo</groupId>
                <artifactId>nizo-mcp</artifactId>
                <version>${nizo.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.nizo</groupId>
                <artifactId>nizo-scheduler</artifactId>
                <version>${nizo.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.nizo</groupId>
                <artifactId>nizo-channels</artifactId>
                <version>${nizo.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.nizo</groupId>
                <artifactId>nizo-agent</artifactId>
                <version>${nizo.version}</version>
            </dependency>

            <dependency>
                <groupId>ai.nizo.memory</groupId>
                <artifactId>nizo-memory-api</artifactId>
                <version>${nizo.memory.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.nizo.memory</groupId>
                <artifactId>nizo-memory-core</artifactId>
                <version>${nizo.memory.version}</version>
            </dependency>
            <dependency>
                <groupId>ai.nizo.memory</groupId>
                <artifactId>nizo-memory-client</artifactId>
                <version>${nizo.memory.version}</version>
            </dependency>

            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.dataformat</groupId>
                <artifactId>jackson-dataformat-yaml</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-simple</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.telegram</groupId>
                <artifactId>telegrambots-meta</artifactId>
                <version>${telegrambots.version}</version>
            </dependency>
            <dependency>
                <groupId>org.telegram</groupId>
                <artifactId>telegrambots-longpolling</artifactId>
                <version>${telegrambots.version}</version>
            </dependency>
            <dependency>
                <groupId>org.telegram</groupId>
                <artifactId>telegrambots-client</artifactId>
                <version>${telegrambots.version}</version>
            </dependency>
            <dependency>
                <groupId>com.cronutils</groupId>
                <artifactId>cron-utils</artifactId>
                <version>${cronutils.version}</version>
            </dependency>
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli</artifactId>
                <version>${picocli.version}</version>
            </dependency>
            <dependency>
                <groupId>org.jsoup</groupId>
                <artifactId>jsoup</artifactId>
                <version>${jsoup.version}</version>
            </dependency>
            <dependency>
                <groupId>org.xerial</groupId>
                <artifactId>sqlite-jdbc</artifactId>
                <version>${sqlite.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
                <plugin>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.1</version>
                </plugin>
                <plugin>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.5.3</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
